# ─── ICCSB 2026 Conference Website — Environment Variables ───
#
# Copy this file to `.env` and adjust values for your deployment.

# Base path for React Router (client-side routing).
# Set to "/" for root deployments. For subdirectory deployments, include
# a leading and trailing slash, e.g. "/conference/" or "/React/CSE_Website/".
VITE_BASE_PATH=/
